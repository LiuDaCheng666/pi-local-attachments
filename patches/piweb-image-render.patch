+async function uploadPastedFile(file: File, cwd: string): Promise<string> {
+  const dot = file.name.lastIndexOf(".");
+  const stem = dot > 0 ? file.name.slice(0, dot) : file.name;
+  const ext = dot > 0 ? file.name.slice(dot) : "";
+  const uniqueName = `${stem}__paste_${new Date().toISOString().replace(/[-:TZ.]/g, "").slice(0, 14)}_${Math.random().toString(36).slice(2, 7)}${ext}`;
+  const formData = new FormData();
+  formData.append("files", file, uniqueName);
+  const response = await fetch(
+    `/api/files/${encodeFilePathForApi(cwd)}?type=upload&conflict=error`,
+    { method: "POST", body: formData },
+  );
+  const result = await response.json().catch(() => ({})) as { uploaded?: string[]; error?: string };
+  const name = result.uploaded?.[0];
+  if (!response.ok || !name) {
+    throw new Error(result.error ?? `Upload failed (HTTP ${response.status})`);
+  }
+  return `${cwd.replace(/[\\/]$/, "")}\\${name}`;
+}
